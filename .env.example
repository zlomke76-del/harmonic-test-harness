# Harmonic Public Test Harness
# Copy to .env.local for local development. Never commit real secrets.

# Hosted UI/API access: required in production, minimum 24 characters.
# Browser HTTP Basic username: harness. Keep password server-side.
# Local development remains accessible when this variable is unset.
HARNESS_ACCESS_PASSWORD=

# --- Harmonic current single-call API ---
HARMONIC_API_URL=https://www.solace-harmonic.com/api/evaluate
HARMONIC_API_KEY=YOUR_HARMONIC_API_KEY

# Optional aliases retained for compatibility with older local setups.
# Prefer HARMONIC_API_KEY and HARMONIC_API_URL for current public integrations.
HARMONIC_ONLY_API_URL=
HARMONIC_ONLY_API_KEY=
HARMONIC_GOVERNANCE_API_KEY=

# Optional: fail the enclosing request if Harmonic transport fails.
STRICT_GOVERNANCE_API=false

# --- Model provider configuration for UI/model-comparison features ---
# Preferred on Vercel: AI Gateway.
VERCEL_AI_GATEWAY_API_KEY=YOUR_VERCEL_AI_GATEWAY_API_KEY
VERCEL_AI_GATEWAY_MODEL=openai/gpt-4.1-mini
VERCEL_AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# Optional aliases used by existing UI code.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# Optional direct OpenAI fallback for local development.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini

# --- Historical/frozen runtime comparisons ---
# Configure only when intentionally examining a historical frozen deployment.
# Current public integrations do not use the retired direct Governance Pack endpoint.
HARMONIC_V40_API_URL=
HARMONIC_V40_API_BASE_URL=
HARMONIC_V40_API_KEY=

HARMONIC_V2_API_BASE_URL=https://www.solace-harmonic.com
HARMONIC_V2_API_KEY=

# V2 emergency evidence-chain validation.
# Enable only for the controlled historical validation run.
HARMONIC_V2_EVIDENCE_CHAIN_VALIDATION=false

# --- Synthetic secure-execution sink ---
# Required only when exercising the sink route against an externally issued signed receipt.
# Do not commit private/signing key material.
HARMONIC_SECURE_EXECUTION_PUBLIC_KEY_PEM=
